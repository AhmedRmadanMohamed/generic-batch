<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.2</version>
        <relativePath/>
    </parent>
    <groupId>gov.csr</groupId>
    <artifactId>GENERIC-BATCH</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>generic-batch</name>
    <description>generic-batch</description>
    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <build.number>LOCAL</build.number>
        <docker.registry>registry.sumerge.local</docker.registry>
        <k8s.namespace>csr</k8s.namespace>
        <spring-cloud.version>2024.0.0</spring-cloud.version>
        <skip.surefire.tests>false</skip.surefire.tests>
        <spring-boot.build-image.imageName>${docker.registry}/${k8s.namespace}/${project.artifactId}:${project.version}</spring-boot.build-image.imageName>
        <jkube.generator.name>${spring-boot.build-image.imageName}</jkube.generator.name>
        <docker.skip.tag>true</docker.skip.tag>
    </properties>
    <scm>
        <url>http://git.sumerge.com/momra-inspections/momra-template</url>
    </scm>
    <issueManagement>
        <system>RTC</system>
        <url>https://jts.sumerge.com/ccm/web/projects/MCI%20(Change%20Management)</url>
    </issueManagement>
